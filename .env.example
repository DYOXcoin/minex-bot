# For automated payouts only. NEVER commit this value.
TREASURY_MNEMONIC=DO_NOT_PUT_IN_GITHUB

# Public TON Connect manifest URL
TONCONNECT_MANIFEST_URL=https://YOUR_DOMAIN.example/tonconnect-manifest.json